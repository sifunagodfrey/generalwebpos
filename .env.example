APP_NAME="Nation Mabati"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost/nationmabati
ASSET_URL=http://localhost/nationmabati
ADMIN_DOMAIN=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_KE
APP_TIMEZONE=Africa/Nairobi

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nation_mabati
DB_USERNAME=root
DB_PASSWORD=
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120
AUTH_PASSWORD_RESET_TOKEN_TABLE=su_password_reset_tokens
DB_QUEUE_TABLE=su_jobs
DB_QUEUE_BATCH_TABLE=su_job_batches
QUEUE_FAILED_TABLE=su_failed_jobs
DB_CACHE_TABLE=su_cache
DB_CACHE_LOCK_TABLE=su_cache_locks

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=public

CACHE_STORE=file

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="info@nationmabati.co.ke"
MAIL_FROM_NAME="${APP_NAME}"

# ---------------
# Company details used on documents and across the site
# ---------------
COMPANY_LEGAL_NAME="Nation Mabati Factory Limited"
COMPANY_PHONE="+254709080399"
COMPANY_WHATSAPP="254709080399"
COMPANY_EMAIL="info@nationmabati.co.ke"
COMPANY_ADDRESS="Nairobi, Kenya"
COMPANY_KRA_PIN=

# ---------------
# M-Pesa Daraja
# Set MPESA_ENV=production and swap in live credentials when going live
# ---------------
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=9529419
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerBuyGoodsOnline
MPESA_CALLBACK_URL="${APP_URL}/payments/mpesa/callback"

# ---------------
# Equity Bank details shown on invoices and at checkout
# ---------------
BANK_NAME="Equity Bank"
BANK_TILL_NUMBER=247247
BANK_ACCOUNT_NUMBER=0870283785591
BANK_ACCOUNT_NAME="Nation Mabati Factory Limited"

# ---------------
# SMS gateway
# ---------------
SMS_PROVIDER=africastalking
SMS_API_KEY=
SMS_USERNAME=
SMS_SENDER_ID=

# ---------------
# Pricing rules for products sold by the metre
# ---------------
MABATI_MIN_LENGTH=1
MABATI_MAX_LENGTH=12
MABATI_LENGTH_STEP=0.1

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
